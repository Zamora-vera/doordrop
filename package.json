{
  "name": "ship24go-enviox",
  "private": true,
  "version": "1.5.3",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "cp -f index.source.html index.html && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && cp -rf dist/* . && cp -f index.source.html index.html",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@paypal/paypal-server-sdk": "^2.4.0",
    "@polar-sh/sdk": "^0.48.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "imapflow": "^2.0.5",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.28",
    "motion": "^12.23.24",
    "mysql2": "^3.22.5",
    "nodemailer": "^10.0.9",
    "react": "^19.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
