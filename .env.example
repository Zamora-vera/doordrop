# Ship24Go / EnvioX V1 - variables de producción
NODE_ENV=production
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ship24go
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_DATABASE=ship24go

APP_URL=https://ship24go.com
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS_MINIMUM
ADMIN_EMAIL=admin@ship24go.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_12_CHARS_MINIMUM

# Opcional: Google Maps para vistas con mapas
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Opcional: AI interno
GEMINI_API_KEY=

# WhatsApp Web interno del Centro de Asistencia (solo Super Admin; no usa Zernio)
WHATSAPP_INTERNAL_ENABLED=true
WHATSAPP_INTERNAL_AUTOSTART=true
WHATSAPP_INTERNAL_DATA_PATH=/app/data/whatsapp-internal
WHATSAPP_INTERNAL_CHROME_PATH=

# DoorDrop correo corporativo (solo backend; nunca usar VITE_ ni exponer al cliente)
MAIL_FROM_EMAIL=info@doordrop.lat
MAIL_FROM_NAME=DoorDrop
SMTP_HOST=smtp.truobox.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
IMAP_HOST=mail.doordrop.lat
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=info@doordrop.lat
IMAP_PASS=

# Marketplace Matterhorn (solo servidor; nunca usar VITE_ ni exponer al cliente)
MATTERHORN_API_KEY=
MATTERHORN_BASE_URL=https://matterhorn-wholesale.com/B2BAPI
MATTERHORN_STORE_EMAIL=moda@doordrop.lat
MATTERHORN_STORE_COUNTRY=IT
MATTERHORN_STORE_CITY=Roma
MATTERHORN_STORE_ZIP=00072

# Contacto interno enviado a proveedores (el cliente no ve el proveedor real)
SHIP24GO_PROVIDER_CONTACT_EMAIL=help@ship24go.com

# ParcelABC
PARCELABC_ENABLED=true
PARCELABC_BASE_URL=https://www.parcelabc.com/api-pabc.php
PARCELABC_AUTH_TOKEN=CHANGE_ME
PARCELABC_ALLOW_REAL_CREATE=false

# Genei V1
GENEI_ENABLED=true
GENEI_API_MODE=v1
GENEI_V1_BASE_URL=https://v1.genei.es/json_interface
GENEI_V1_USER=CHANGE_ME
GENEI_V1_PASSWORD=CHANGE_ME
GENEI_V1_ALLOW_REAL_CREATE=false
GENEI_V1_CREATE_FUNCTION=crear_envio_sandbox

# Paccofacile
PACCOFACILE_ENABLED=true
PACCOFACILE_MODE=sandbox
PACCOFACILE_SANDBOX_BASE_URL=https://paccofacile.tecnosogima.cloud/sandbox
PACCOFACILE_LIVE_BASE_URL=https://paccofacile.tecnosogima.cloud/live
PACCOFACILE_API_VERSION=v1
PACCOFACILE_ALLOW_REAL_BUY=false
PACCOFACILE_TOKEN=CHANGE_ME
PACCOFACILE_API_KEY=CHANGE_ME
PACCOFACILE_ACCOUNT_NUMBER=CHANGE_ME

# Cron de procesamiento de envíos
SHIPMENT_CRON_KEY=CHANGE_ME_RANDOM_CRON_KEY

# SpedirePro API v1
SPEDIREPRO_BASE_URL=https://www.spedirepro.com/public-api
SPEDIREPRO_API_KEY=CHANGE_ME
SPEDIREPRO_ALLOW_REAL_BUY=false
SPEDIREPRO_WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET

# Genei webhook HMAC secret. Leave unset only while the provider webhook is disabled.
GENEI_WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET


# SpediamoPro API v2
SPEDIAMOPRO_MODE=production
SPEDIAMOPRO_BASE_URL=https://core.spediamopro.com/api/v2
SPEDIAMOPRO_STAGING_BASE_URL=https://core.spediamopro.it/api/v2
SPEDIAMOPRO_PRODUCTION_BASE_URL=https://core.spediamopro.com/api/v2
SPEDIAMOPRO_AUTHCODE=
SPEDIAMOPRO_ALLOW_REAL_BUY=false
# EasyPost API v2
EASYPOST_MODE=test
EASYPOST_BASE_URL=https://api.easypost.com/v2
EASYPOST_TEST_API_KEY=
EASYPOST_PRODUCTION_API_KEY=
EASYPOST_ALLOW_REAL_BUY=false
EASYPOST_ALLOW_TEST_LABELS=true
EASYPOST_WEBHOOK_SECRET=

# Ecart API Stores / Ecommerce Orders
ECARTAPI_ENABLED=true
ECARTAPI_APP_ID=D32kBQglwHbylGMYnlwMLcOWD6fsGb2o
ECARTAPI_CLIENT_SECRET=
ECARTAPI_APP_URL=https://ship24go.com
ECARTAPI_REDIRECT_URL=https://ship24go.com/api/integrations/ecartapi/callback
ECARTAPI_BASE_URL=https://api.ecartapi.com
ECARTAPI_API_VERSION=v2
STORES_SYNC_CRON_KEY=CHANGE_ME_RANDOM_STORES_CRON_KEY
